{
  "commands": {
    "dev": { "script": "pnpm", "args": ["--filter", "@flow-spaces/web", "dev", "--host", "127.0.0.1"], "desc": "Vite web dev server (apps/web, IPv4 127.0.0.1:5173 for Electron shell)" },
    "dev:server": { "script": "pnpm", "args": ["--filter", "@flow-spaces/server", "dev"], "desc": "Server watch mode (tsx watch src/app.ts)" },
    "build": { "script": "pnpm", "args": ["build"], "desc": "Build packages then web app" },
    "build:packages": { "script": "pnpm", "args": ["build:packages"], "desc": "Build @flow-spaces/shared and @flow-spaces/sdk" },
    "preview": { "script": "pnpm", "args": ["preview"], "desc": "Preview built web app" },
    "typecheck": { "script": "pnpm", "args": ["typecheck"], "desc": "TypeScript check for web app" },
    "electron:dev": { "script": "pnpm", "args": ["--filter", "@flow-spaces/web", "electron:dev"], "desc": "Electron dev shell (loads Vite dev server on 5173, run 'dev' first)" },
    "electron:dev:full": { "script": "node", "args": ["scripts/electron-dev-full.mjs"], "desc": "Vite + Electron one-shot dev (concurrent start, run alone — port 5173 & single-instance lock)" }
  }
}
