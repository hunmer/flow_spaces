# Flow Spaces 独立 server 实例配置（dotenv 由 src/app.ts 顶部 loadDotenv() 加载，cwd=packages/server）
# 独立端口：与原 flow-spaces (3100) 并存互不干扰
PORT=3110
# 独立数据目录：与原 flow-spaces (~/.flow-spaces-data) 完全隔离；
# 新目录无 auth.json → getSecret()='' → authMiddleware 全放行（免鉴权模式）
FLOW_SPACES_DATA_DIR=./flow-spaces-data
FLOW_SPACES_PLUGINS_DIR=E:/flow-spaces-plugins
FLOW_SPACES_WORKFLOWS_DIR=E:/flow-spaces-workflows
FLOW_SPACES_MINI_APPS_DIR=E:/flow-spaces-mini-apps
