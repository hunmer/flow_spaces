# Flow Spaces server 本地环境配置示例
# 复制为 .env 使用；公网部署请用系统环境变量注入，勿提交真实值。

# 服务端口（默认 3100）
PORT=3100

# 运行时数据目录（默认 ~/.flow-spaces-data）
# FLOW_SPACES_DATA_DIR=

# 独立资源目录（未设置时使用 <dataDir>/plugins、workflows、mini-apps）
# 支持绝对路径或相对于 server 工作目录的路径；直接读写该目录，无需复制。
# FLOW_SPACES_PLUGINS_DIR=E:/flow-spaces-plugins
# FLOW_SPACES_WORKFLOWS_DIR=E:/flow-spaces-workflows
# FLOW_SPACES_MINI_APPS_DIR=E:/flow-spaces-mini-apps

# 登录密码：POST /api/auth/login 的 { password }；未设置时回落 <dataDir>/auth.json 的 secret
FLOW_SPACES_PASSWORD=<your-password>

# API / MCP Bearer token：客户端鉴权令牌；未设置时回落 <dataDir>/auth.json 的 secret
FLOW_SPACES_TOKEN=<random-token>
